# Server only — no real credentials in this file
# Required in production: signs the anonymous session cookie (32+ random chars).
SESSION_COOKIE_SECRET=replace_with_long_random_secret

# Optional AI narration (OpenAI Responses API). Without these, fixed stories are used.
OPENAI_API_KEY=replace_me
OPENAI_MODEL=configure_model
DISABLE_AI_GENERATION=false
# Optional neural voice for subtitles (browser speech is used when unset)
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=sage

# Not used by v2.0 (sessions are stateless signed cookies). Reserved for the
# PostgreSQL persistence described in 仕様書.md §8 — see docs/ADR/0001.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Optional rate limit integration (in-memory limiter is used when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Browser-safe public metadata only
NEXT_PUBLIC_APP_VERSION=2.0.0
# true ships the offline demo (which contains the puzzle answer) in the client bundle.
NEXT_PUBLIC_ENABLE_DEMO=false
